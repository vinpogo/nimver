#!/usr/bin/env bash
#
# .agents/prepare - configures a checkout that Delta just created.
#
# This runs for *every* worktree, so it has to stay cheap: only local
# filesystem checks and a couple of sub-100ms commands. No builds, no network,
# no toolchain installs. If something needed here is missing, warn and move on
# rather than blocking the worktree.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

log() { printf 'prepare: %s\n' "$*" >&2; }

# --- nimver ----------------------------------------------------------------
# Nim projects in this workspace version themselves with nimver: Conventional
# Commits are validated by a commit-msg hook, and a release reads the bump
# levels straight off the commits. A fresh checkout has no hooks (git never
# clones them), so install it here.

shopt -s nullglob
nimble_manifests=(*.nimble)
shopt -u nullglob

if [[ ! -f .nimver/config.ini ]]; then
  if ((${#nimble_manifests[@]} > 0)); then
    log "Nim project without .nimver/config.ini; run 'nimver init' to enable versioning"
  fi
  exit 0
fi

# nimver is installed into the nimble bin dir, which a shell only has on PATH
# once the toolchain is active.
nimver_bin="$(command -v nimver 2>/dev/null || true)"
if [[ -z $nimver_bin ]]; then
  log "warning: nimver not found; hooks will look it up on PATH at commit time"
  log "         install it with 'nimble install' from the nimver repo"
  nimver_bin=nimver
fi

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  exit 0 # not a git checkout, so there is nowhere to put hooks
fi

# `git rev-parse --git-path` resolves the real hooks directory even when .git
# is a gitfile (which it always is in a Delta checkout), unlike the plain
# repoRoot/.git/hooks path that `nimver install-hooks` assumes.
hooks_dir="$(git rev-parse --git-path hooks)"
mkdir -p "$hooks_dir"

# The hook body mirrors `nimver install-hooks` (src/commands/installHooks.nim)
# rather than shelling out to it: the hook needs the absolute path resolved
# above, since the shell that runs it has no guarantee of an activated
# toolchain on PATH. Writing it here also keeps a checkout working when nimver
# is not installed yet, or is older than the release that taught
# `install-hooks` about checkouts whose .git is a file.
#
# A hook is only ever replaced when it carries a marker proving it was
# generated - our own, or the one `nimver install-hooks` writes. A hook that
# merely mentions nimver is assumed to be hand-written (it may call nimver
# *and* do other work), and git shares one hooks directory across every
# worktree of a repository, so overwriting it would break all of them.
marker='# managed-by: .agents/prepare (nimver hooks)'
# From src/commands/installHooks.nim. If that text ever changes, the worst case
# is that we stop recognising nimver's own hooks and leave them in place.
nimver_marker='# Installed by nimver. Do not edit by hand;'

write_hook() {
  local name=$1 body=$2
  local path="$hooks_dir/$name"
  if [[ -e $path ]] && ! grep -qxF -e "$marker" -e "$nimver_marker" "$path"; then
    log "warning: $path is hand-written; leaving it alone"
    log "         nimver's $name hook was not installed"
    return
  fi
  printf '%s\n' "$body" >"$path"
  chmod +x "$path"
}

write_hook commit-msg "$(
  cat <<EOF
#!/bin/sh
${marker}
# Regenerate by re-running .agents/prepare; mirrors \`nimver install-hooks\`.
NIMVER='${nimver_bin}'
command -v "\$NIMVER" >/dev/null 2>&1 || NIMVER=nimver
exec "\$NIMVER" check-commit-msg "\$1"
EOF
)"

# nimver used to keep a file per pending change, written by a post-commit hook
# and kept in step with its commit by a post-rewrite one. A release reads the
# commits themselves now, and those hooks call subcommands that no longer
# exist - left behind in a checkout they would fail on every commit.
for retired in post-commit post-rewrite; do
  path="$hooks_dir/$retired"
  if [[ -e $path ]] && grep -qxF -e "$marker" -e "$nimver_marker" "$path"; then
    rm -f "$path"
    log "removed obsolete $retired hook"
  fi
done
