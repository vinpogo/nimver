{
  "private_files": [
    "**/.env",
    "**/.env.*",
    "**/.envrc",
    "**/*.pem",
    "**/*.key",
    "**/secrets/**",
    "**/*secret*",
  ],
  "file_scan_exclusions": ["**/.env.*", "**/.envrc", "**/*.pem", "**/*.key"],
  "lsp": {
    "deno": {
      "settings": {
        "deno": {
          "enable": true,
          "unstable": true,
        },
      },
    },
  },
  "languages": {
    "JSONC": {
      "language_servers": ["!json-language-server", "!oxfmt"],
    },
    "JSON": {
      "language_servers": ["!json-language-server", "!oxfmt"],
    },
    "Markdown": {
      "language_servers": ["!oxfmt"],
    },
    "Nim": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "nph",
          "arguments": ["-"],
        },
      },
    },
  },
}
